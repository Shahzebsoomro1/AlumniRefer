# ==========================================
# Alumni Job Referral Portal Configuration
# ==========================================

# Secret key (change in production)
SECRET_KEY=django-insecure-alumni-portal-change-this-in-production-2024
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,*

# Database Configuration
# Set USE_POSTGRES=True to connect to PostgreSQL (or False for instant SQLite local dev)
USE_POSTGRES=False

# PostgreSQL Settings (used when USE_POSTGRES=True)
POSTGRES_DB=alumni_portal_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
